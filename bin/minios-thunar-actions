#!/usr/bin/python3
from __future__ import print_function

from collections import deque
import gettext
import json
import os
import subprocess
import sys

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk
from minios_gui import (CommandRunner, ProgressDialog, apply_minios_css,
                        choose_save_file, show_error_dialog)

DOMAIN = 'minios-thunar-actions'
LOCALE_DIR = '/usr/share/locale'
DIR2SB = '/usr/bin/dir2sb'
SB2DIR = '/usr/bin/sb2dir'
SB = '/usr/bin/sb'
PKEXEC = '/usr/bin/pkexec'
FINDMNT_PATHS = ('/usr/bin/findmnt', '/bin/findmnt')


def translator(localedir=LOCALE_DIR):
    return gettext.translation(
        DOMAIN, localedir=localedir, fallback=True).gettext


_ = translator()


def findmnt_path():
    for path in FINDMNT_PATHS:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def root_fstype():
    executable = findmnt_path()
    if executable is None:
        return ''
    try:
        output = subprocess.check_output(
            [executable, '-rn', '--mountpoint', '/', '-o', 'FSTYPE'],
            universal_newlines=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError):
        return ''
    return output.strip()


def build_conversion_argv(operation, source, target):
    if operation == 'create':
        return [DIR2SB, '--json', '--', source, target]
    if operation == 'extract':
        return [SB2DIR, '--json', '--', source, target]
    raise ValueError('unsupported conversion operation')


def build_runtime_argv(operation, path):
    if operation not in ('activate', 'deactivate'):
        raise ValueError('unsupported runtime operation')
    return [PKEXEC, SB, operation, path]


def default_create_target(source):
    source = os.path.abspath(source)
    base = os.path.basename(source.rstrip(os.sep)) or 'module'
    return os.path.join(os.path.dirname(source.rstrip(os.sep)), base + '.sb')


def default_extract_target(source):
    source = os.path.abspath(source)
    base = os.path.basename(source)
    if base.endswith('.sb'):
        base = base[:-3]
    if not base:
        base = 'module'
    return os.path.join(os.path.dirname(source), base)


def show_error(title, message, details=None, parent=None):
    secondary = message
    if details:
        secondary += '\n\n' + details[-6000:]
    show_error_dialog(parent, title, secondary)


def choose_target(source, operation):
    if operation == 'create':
        default = default_create_target(source)
        title = _('Create Module')
        accept = _('Create')
    else:
        default = default_extract_target(source)
        title = _('Extract Module')
        accept = _('Extract')

    while True:
        target = choose_save_file(
            title=title, current_folder=os.path.dirname(default),
            current_name=os.path.basename(default), accept_label=accept,
            overwrite_confirmation=False)
        if target is None:
            return None
        if operation == 'create' and not target.endswith('.sb'):
            target += '.sb'
        if not os.path.lexists(target):
            return target
        show_error(title, _('The selected destination already exists.'))
        default = target


class ProgressJob(object):
    def __init__(self, title, message, argv, default_size, cancellable=False,
                 detail_limit=200):
        self.argv = argv
        self.stdout = deque(maxlen=detail_limit)
        self.stderr = deque(maxlen=detail_limit)
        self.frontend_error = None
        self.cancelled = False
        self.returncode = None
        self.finished = False

        self.dialog = ProgressDialog(
            title=title, status=message, cancellable=cancellable)
        self.dialog.set_default_size(*default_size)
        self.dialog.set_deletable(False)
        self.view = self.dialog.operation_view
        self.label = self.view.status_label
        self.cancel = self.view.cancel_button
        self.dialog.connect('response', self._on_response)
        self.runner = CommandRunner(
            argv, self._handle_stdout_line, self._finished,
            stderr_callback=self._handle_stderr_line,
            maximum_output_bytes=1024 * 1024)

    def _on_response(self, _dialog, response):
        if response != Gtk.ResponseType.CANCEL or self.finished:
            return
        self.cancelled = True
        self.label.set_text(_('Cancelling…'))
        self.runner.cancel()

    def _handle_stdout_line(self, line):
        self.stdout.append(line.rstrip())

    def _handle_stderr_line(self, line):
        self.stderr.append(line.rstrip())

    def _finished(self, returncode, cancelled):
        self.returncode = returncode
        self.cancelled = cancelled
        self.finished = True
        if cancelled:
            self.view.set_state('cancelled', _('Cancelled.'))
        elif returncode == 0:
            self.view.set_state('success', _('Completed successfully.'))
        else:
            self.view.set_state('error', _('The module operation failed.'))
        self.dialog.response(Gtk.ResponseType.OK)
        return False

    def run(self):
        self.dialog.show_all()
        self.view.set_state('running')
        try:
            self.runner.start()
            while not self.finished:
                self.dialog.run()
        except Exception as error:
            self.frontend_error = str(error)
            self.returncode = 127
        self.dialog.destroy()
        return self._result()

    def _stderr_text(self):
        return '\n'.join(self.stderr).strip()

    def _stdout_text(self):
        return '\n'.join(self.stdout).strip()

    def _result(self):
        raise NotImplementedError


class ConversionJob(ProgressJob):
    def __init__(self, title, argv):
        self.protocol_error = None
        super(ConversionJob, self).__init__(
            title, _('Preparing…'), argv, (440, 130), cancellable=True,
            detail_limit=200)

    def _phase(self, phase):
        labels = {
            'prepare': _('Preparing…'),
            'compress': _('Compressing module…'),
            'verify': _('Verifying module…'),
            'publish': _('Publishing result…'),
            'extract': _('Extracting module…'),
            'complete': _('Finishing…'),
        }
        self.label.set_text(labels.get(phase, _('Working…')))
        return False

    def _handle_stdout_line(self, line):
        line = line.strip()
        if not line:
            return
        try:
            record = json.loads(line)
        except ValueError:
            self.protocol_error = _(
                'The module tool returned invalid progress data.')
            return
        if not isinstance(record, dict):
            self.protocol_error = _(
                'The module tool returned invalid progress data.')
            return
        if record.get('event') == 'phase':
            phase = record.get('phase')
            if isinstance(phase, str):
                self._phase(phase)

    def _result(self):
        details = self._stderr_text()
        for frontend_detail in (self.protocol_error, self.frontend_error):
            if not frontend_detail:
                continue
            if details:
                details = frontend_detail + '\n' + details
            else:
                details = frontend_detail
        success = (
            self.returncode == 0 and
            self.protocol_error is None and
            self.frontend_error is None and
            not self.cancelled)
        return success, self.cancelled, details


class RuntimeJob(ProgressJob):
    def __init__(self, title, message, argv):
        super(RuntimeJob, self).__init__(
            title, message, argv, (400, 110))

    def _result(self):
        details = self._stderr_text() or self._stdout_text()
        if self.frontend_error:
            details = self.frontend_error + ('\n' + details if details else '')
        return self.returncode == 0 and self.frontend_error is None, details


def run_conversion(operation, source):
    target = choose_target(source, operation)
    if target is None:
        return 0
    if operation == 'create':
        title = _('Creating Module')
    else:
        title = _('Extracting Module')

    argv = build_conversion_argv(operation, source, target)
    success, cancelled, details = ConversionJob(title, argv).run()
    if cancelled:
        return 0
    if not success:
        show_error(title, _('The module operation failed.'), details)
        return 1
    return 0


def run_runtime_action(operation, path):
    if root_fstype() != 'aufs':
        show_error(
            _('MiniOS Module Action'),
            _('This action is available only when the current root filesystem uses AUFS.'))
        return 1

    if operation == 'activate':
        title = _('Activate Module')
        message = _('Activating module…')
    else:
        title = _('Deactivate Module')
        message = _('Deactivating module…')

    success, details = RuntimeJob(
        title, message, build_runtime_argv(operation, path)).run()
    if not success:
        show_error(title, _('The module operation failed.'), details)
        return 1
    return 0


def dispatch(operation, raw_path):
    path = os.path.abspath(raw_path)
    if operation == 'create':
        if not os.path.isdir(path):
            show_error(_('Create Module'),
                       _('The selected path is not a directory.'))
            return 1
        return run_conversion(operation, path)
    if operation == 'extract':
        if not os.path.isfile(path):
            show_error(_('Extract Module'),
                       _('The selected module is not a regular file.'))
            return 1
        return run_conversion(operation, path)
    if operation in ('activate', 'deactivate'):
        return run_runtime_action(operation, path)
    raise ValueError('unsupported operation')


def main():
    apply_minios_css()
    if len(sys.argv) != 3 or sys.argv[1] not in (
            'create', 'extract', 'activate', 'deactivate'):
        show_error(_('MiniOS Module Action'),
                   _('The requested Thunar action is not valid.'))
        return 2
    try:
        return dispatch(sys.argv[1], sys.argv[2])
    except Exception as error:
        show_error(_('MiniOS Module Action'),
                   _('The operation could not be started.'), str(error))
        return 1


if __name__ == '__main__':
    sys.exit(main())
