#!/usr/bin/python3
from __future__ import print_function

from collections import deque
import gettext
import json
import os
import subprocess
import sys
import threading

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import GLib, Gtk

DOMAIN = 'minios-thunar-actions'
LOCALE_DIR = '/usr/share/locale'
DIR2SB = '/usr/bin/dir2sb'
SB2DIR = '/usr/bin/sb2dir'
SB = '/usr/bin/sb'
PKEXEC = '/usr/bin/pkexec'
FINDMNT_PATHS = ('/usr/bin/findmnt', '/bin/findmnt')


def translator(localedir=LOCALE_DIR):
    return gettext.translation(
        DOMAIN, localedir=localedir, fallback=True).gettext


_ = translator()


def findmnt_path():
    for path in FINDMNT_PATHS:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def root_fstype():
    executable = findmnt_path()
    if executable is None:
        return ''
    try:
        output = subprocess.check_output(
            [executable, '-rn', '--mountpoint', '/', '-o', 'FSTYPE'],
            universal_newlines=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError):
        return ''
    return output.strip()


def build_conversion_argv(operation, source, target):
    if operation == 'create':
        return [DIR2SB, '--json', '--', source, target]
    if operation == 'extract':
        return [SB2DIR, '--json', '--', source, target]
    raise ValueError('unsupported conversion operation')


def build_runtime_argv(operation, path):
    if operation not in ('activate', 'deactivate'):
        raise ValueError('unsupported runtime operation')
    return [PKEXEC, SB, operation, path]


def default_create_target(source):
    source = os.path.abspath(source)
    base = os.path.basename(source.rstrip(os.sep)) or 'module'
    return os.path.join(os.path.dirname(source.rstrip(os.sep)), base + '.sb')


def default_extract_target(source):
    source = os.path.abspath(source)
    base = os.path.basename(source)
    if base.endswith('.sb'):
        base = base[:-3]
    if not base:
        base = 'module'
    return os.path.join(os.path.dirname(source), base)


def show_error(title, message, details=None, parent=None):
    dialog = Gtk.MessageDialog(
        transient_for=parent, modal=True, message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.CLOSE, text=title)
    secondary = message
    if details:
        secondary += '\n\n' + details[-6000:]
    dialog.format_secondary_text(secondary)
    dialog.run()
    dialog.destroy()


def choose_target(source, operation):
    if operation == 'create':
        default = default_create_target(source)
        title = _('Create Module')
        accept = _('Create')
    else:
        default = default_extract_target(source)
        title = _('Extract Module')
        accept = _('Extract')

    dialog = Gtk.FileChooserDialog(
        title=title, action=Gtk.FileChooserAction.SAVE)
    dialog.add_buttons(
        _('Cancel'), Gtk.ResponseType.CANCEL,
        accept, Gtk.ResponseType.ACCEPT)
    dialog.set_current_folder(os.path.dirname(default))
    dialog.set_current_name(os.path.basename(default))

    while True:
        response = dialog.run()
        if response != Gtk.ResponseType.ACCEPT:
            dialog.destroy()
            return None
        target = dialog.get_filename()
        if operation == 'create' and not target.endswith('.sb'):
            target += '.sb'
        if not os.path.lexists(target):
            dialog.destroy()
            return target
        show_error(title, _('The selected destination already exists.'),
                   parent=dialog)


class ConversionJob(object):
    def __init__(self, title, argv):
        self.argv = argv
        self.stderr = deque(maxlen=200)
        self.protocol_error = None
        self.frontend_error = None
        self.cancelled = False
        self.returncode = None

        self.dialog = Gtk.Dialog(title=title, modal=True)
        self.dialog.set_default_size(440, 130)
        self.dialog.set_deletable(False)
        box = self.dialog.get_content_area()
        box.set_spacing(10)
        box.set_border_width(14)

        self.label = Gtk.Label(label=_('Preparing…'), xalign=0)
        self.label.set_hexpand(True)
        box.pack_start(self.label, False, False, 0)

        self.progress = Gtk.ProgressBar()
        self.progress.set_hexpand(True)
        self.progress.set_size_request(-1, 18)
        self.progress.set_pulse_step(0.08)
        box.pack_start(self.progress, False, False, 0)
        self._pulse_source = None

        self.cancel = Gtk.Button(label=_('Cancel'))
        self.cancel.connect('clicked', self._cancel)
        action_area = self.dialog.get_action_area()
        action_area.set_layout(Gtk.ButtonBoxStyle.END)
        action_area.pack_end(self.cancel, False, False, 0)

        self.process = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True, bufsize=1)

    def _cancel(self, _button):
        if self.returncode is not None or self.cancelled:
            return
        self.cancelled = True
        self.cancel.set_sensitive(False)
        self.label.set_text(_('Cancelling…'))
        try:
            self.process.terminate()
        except OSError:
            pass

    def _read_stderr(self):
        for line in self.process.stderr:
            self.stderr.append(line.rstrip())

    def _pulse(self):
        if self.returncode is not None:
            self._pulse_source = None
            return False
        self.progress.pulse()
        return True

    def _phase(self, phase):
        labels = {
            'prepare': _('Preparing…'),
            'compress': _('Compressing module…'),
            'verify': _('Verifying module…'),
            'publish': _('Publishing result…'),
            'extract': _('Extracting module…'),
            'complete': _('Finishing…'),
        }
        self.label.set_text(labels.get(phase, _('Working…')))
        return False

    def _worker(self):
        stderr_thread = threading.Thread(target=self._read_stderr)
        stderr_thread.daemon = True
        stderr_thread.start()
        try:
            for line in self.process.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except ValueError:
                    self.protocol_error = _(
                        'The module tool returned invalid progress data.')
                    continue
                if not isinstance(record, dict):
                    self.protocol_error = _(
                        'The module tool returned invalid progress data.')
                    continue
                if record.get('event') == 'phase':
                    phase = record.get('phase')
                    if isinstance(phase, str):
                        GLib.idle_add(self._phase, phase)
        except Exception as error:
            self.frontend_error = str(error)
            try:
                self.process.terminate()
            except OSError:
                pass
        finally:
            self.returncode = self.process.wait()
            stderr_thread.join()
            GLib.idle_add(self._finished)

    def _finished(self):
        self.dialog.response(Gtk.ResponseType.OK)
        return False

    def run(self):
        worker = threading.Thread(target=self._worker)
        worker.daemon = True
        worker.start()
        self.dialog.show_all()
        self._pulse_source = GLib.timeout_add(90, self._pulse)
        self.dialog.run()
        if self._pulse_source is not None:
            GLib.source_remove(self._pulse_source)
            self._pulse_source = None
        self.dialog.destroy()

        details = '\n'.join(self.stderr)
        for frontend_detail in (self.protocol_error, self.frontend_error):
            if not frontend_detail:
                continue
            if details:
                details = frontend_detail + '\n' + details
            else:
                details = frontend_detail
        success = (
            self.returncode == 0 and
            self.protocol_error is None and
            self.frontend_error is None and
            not self.cancelled)
        return success, self.cancelled, details


class RuntimeJob(object):
    def __init__(self, title, message, argv):
        self.argv = argv
        self.returncode = None
        self.stdout = ''
        self.stderr = ''
        self.frontend_error = None
        self.dialog = Gtk.Dialog(title=title, modal=True)
        self.dialog.set_deletable(False)
        self.dialog.set_default_size(400, 110)
        box = self.dialog.get_content_area()
        box.set_spacing(10)
        box.set_border_width(14)
        label = Gtk.Label(label=message, xalign=0)
        box.pack_start(label, False, False, 0)
        self.progress = Gtk.ProgressBar()
        self.progress.set_hexpand(True)
        self.progress.set_size_request(-1, 18)
        self.progress.set_pulse_step(0.08)
        box.pack_start(self.progress, False, False, 0)
        self._pulse_source = None
        self.process = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True)

    def _pulse(self):
        if self.returncode is not None:
            self._pulse_source = None
            return False
        self.progress.pulse()
        return True

    def _worker(self):
        try:
            self.stdout, self.stderr = self.process.communicate()
            self.returncode = self.process.returncode
        except Exception as error:
            self.frontend_error = str(error)
            try:
                self.process.terminate()
            except OSError:
                pass
            self.returncode = self.process.wait()
        finally:
            GLib.idle_add(self._finished)

    def _finished(self):
        self.dialog.response(Gtk.ResponseType.OK)
        return False

    def run(self):
        worker = threading.Thread(target=self._worker)
        worker.daemon = True
        worker.start()
        self.dialog.show_all()
        self._pulse_source = GLib.timeout_add(90, self._pulse)
        self.dialog.run()
        if self._pulse_source is not None:
            GLib.source_remove(self._pulse_source)
            self._pulse_source = None
        self.dialog.destroy()
        details = self.stderr.strip() or self.stdout.strip()
        if self.frontend_error:
            details = self.frontend_error + ('\n' + details if details else '')
        return self.returncode == 0 and self.frontend_error is None, details


def run_conversion(operation, source):
    target = choose_target(source, operation)
    if target is None:
        return 0
    if operation == 'create':
        title = _('Creating Module')
    else:
        title = _('Extracting Module')

    argv = build_conversion_argv(operation, source, target)
    success, cancelled, details = ConversionJob(title, argv).run()
    if cancelled:
        return 0
    if not success:
        show_error(title, _('The module operation failed.'), details)
        return 1
    return 0


def run_runtime_action(operation, path):
    if root_fstype() != 'aufs':
        show_error(
            _('MiniOS Module Action'),
            _('This action is available only when the current root filesystem uses AUFS.'))
        return 1

    if operation == 'activate':
        title = _('Activate Module')
        message = _('Activating module…')
    else:
        title = _('Deactivate Module')
        message = _('Deactivating module…')

    success, details = RuntimeJob(
        title, message, build_runtime_argv(operation, path)).run()
    if not success:
        show_error(title, _('The module operation failed.'), details)
        return 1
    return 0


def dispatch(operation, raw_path):
    path = os.path.abspath(raw_path)
    if operation == 'create':
        if not os.path.isdir(path):
            show_error(_('Create Module'),
                       _('The selected path is not a directory.'))
            return 1
        return run_conversion(operation, path)
    if operation == 'extract':
        if not os.path.isfile(path):
            show_error(_('Extract Module'),
                       _('The selected module is not a regular file.'))
            return 1
        return run_conversion(operation, path)
    if operation in ('activate', 'deactivate'):
        return run_runtime_action(operation, path)
    raise ValueError('unsupported operation')


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in (
            'create', 'extract', 'activate', 'deactivate'):
        show_error(_('MiniOS Module Action'),
                   _('The requested Thunar action is not valid.'))
        return 2
    try:
        return dispatch(sys.argv[1], sys.argv[2])
    except Exception as error:
        show_error(_('MiniOS Module Action'),
                   _('The operation could not be started.'), str(error))
        return 1


if __name__ == '__main__':
    sys.exit(main())
